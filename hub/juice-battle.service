[Unit]
Description=Juice Battle Main App
Documentation=file:///home/arduino/ArduinoApps/juice_battle/docs/HANDOFF_FINAL.md
After=network.target juice-ble-scanner.service

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/ArduinoApps/juice_battle
ExecStart=/usr/bin/python3 hub/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jb-main
Environment=PYTHONUNBUFFERED=1
# SDL opens the ALSA "default" PCM, which ~/.asoundrc routes through dmix.
# Do NOT add AUDIODEV=hw:Device here — it makes SDL open the raw hw device and
# bypass the dmix buffering layer, causing a continuous ALSA underrun storm.
Environment=SDL_AUDIODRIVER=alsa
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
